{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.4",
      "maxDuration": 15
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "same-origin"
      },
      "continue": true
    },
    { "src": "/includes/.*", "status": 404 },
    { "src": "/api/php\\.ini", "status": 404 },
    { "src": "/vercel\\.json", "status": 404 }
  ]
}
